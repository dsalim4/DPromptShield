# REQUIRED: existing SQL Server backend must be reachable from Cloud Run or local host
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=DPromptShieldDB
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false
TRUSTED_PROXY_IPS=
PORT=8080
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=15
INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Gemini AI features (store as Cloud Run Secret, never commit real values)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Firestore audit metadata; Cloud Run service account needs Cloud Datastore User role
FIREBASE_PROJECT_ID=your-gcp-project-id
FIRESTORE_AUDIT_ENABLED=true

# Exact comma-separated browser origins allowed to call the API.
# Include the deployed extension origin and any cross-origin admin console origin only.
CORS_ALLOWED_ORIGINS=chrome-extension://dekohbbgboflmeikbohfokimiojiioci
